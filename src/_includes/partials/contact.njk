
<div  class="govuk-!-padding-bottom-8" >

 <h2 class="bow-heading-l font-univers-tagline">Contact us</h2>

<form
  name="contact"
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="bot-field"
 
  netlify
>
  {# Netlify needs this hidden input to match the form name #}
  <input type="hidden" name="form-name" value="contact" />

  {# Honeypot field (hidden from humans) #}
  <p class="bow-visually-hidden">
    <label>Don’t fill this out: <input name="bot-field" /></label>
  </p>

 <div class="bow-grid-row">
 <div class="bow-grid-column-one-half">
  <div class="bow-form-group">
    
      <label class="bow-label" for="name">Name</label>
      <input class="bow-input" id="name" name="name" type="text" required />
    </div>
  </div>
<div class="bow-grid-column-one-half">
  <div class="bow-form-group">
    
      <label class="bow-label" for="email">Email</label>
      <input class="bow-input" id="email" name="email" type="email" required />
    </div>
  </div>
</div>


  <div class="bow-form-group">
    <label class="bow-label" for="phone">Phone</label>
    <input class="bow-input" id="phone" name="phone" type="tel" />
  </div>

  <div class="bow-form-group">
    <label class="bow-label" for="message">Message</label>
    <textarea class="bow-textarea" id="message" name="message" rows="6" required></textarea>
  </div>



  <button class="bow-button" type="submit">Send</button>
</form>
</div>