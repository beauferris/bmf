<header class="bow-header site-header" role="banner" data-module="bow-header">
  <div class="bow-header__bar bow-width-container">
    <div class="bow-header__logo">
      <a href="/" class="bow-header__link bow-header__link--homepage">
        <img
          src="/assets/images/logo.png"
          alt="{{ site.name }}"
          width="150"
          height="51"
          decoding="async"
          fetchpriority="high"
        />
      </a>
    </div>
    <div class="bow-header__end">
      <nav class="bow-header__desktop-nav" aria-label="Primary navigation">
        <ul class="bow-header__nav-list">
          <li>
            <a
              href="/"
              class="bow-header__nav-link"
              {% if page.url == '/' %}aria-current="page"{% endif %}
            >Home</a>
          </li>
          <li>
            <a
              href="/services/"
              class="bow-header__nav-link"
              {% if page.url and '/services' in page.url %}aria-current="page"{% endif %}
            >Services</a>
          </li>
          <li>
            <a
              href="/contact/"
              class="bow-header__nav-link"
              {% if page.url == '/contact/' %}aria-current="page"{% endif %}
            >Contact</a>
          </li>
        </ul>
      </nav>
      <button
        type="button"
        id="menu-toggle"
        class="bow-header__menu-button"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="bow-header__menu-bars" aria-hidden="true">
          <span class="bow-header__menu-bar"></span>
          <span class="bow-header__menu-bar"></span>
          <span class="bow-header__menu-bar"></span>
        </span>
        <span class="bow-header__menu-close" aria-hidden="true">×</span>
      </button>
    </div>
  </div>
  <div id="mobile-menu-panel" class="bow-header__mobile-panel" aria-hidden="true">
    <div class="bow-width-container bow-header__mobile-inner">
    <nav aria-label="Mobile navigation">
      <ul class="bow-header__mobile-list">
        <li class="bow-header__mobile-item">
          <a href="/" class="bow-header__mobile-link">Home</a>
        </li>
        <li class="bow-header__mobile-item">
          <a href="/services/" class="bow-header__mobile-link">Services</a>
        </li>
        <li class="bow-header__mobile-item bow-header__mobile-item--last">
          <a href="/contact/" class="bow-header__mobile-link">Contact</a>
        </li>
      </ul>
    </nav>
    </div>
  </div>
</header>
